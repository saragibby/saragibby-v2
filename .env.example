# Explicit draft-only visual preview. Production must use false.
SITE_PREVIEW=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000
# Both URL variables must identify the same origin.

# Configure a separate database for each environment. Never reuse production for tests.
DATABASE_URL=
DATABASE_POOL_MAX=5
# PEM CA certificate, quoted if multiline. Certificate verification stays enabled.
DATABASE_CA_CERT=
PAYLOAD_SECRET=
EMAIL_SIGNING_SECRET=

# Supabase S3-compatible endpoint and bucket credentials (server-side only).
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_SERVICE_KEY=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_PUBLIC_MEDIA_BUCKET=
SUPABASE_PRIVATE_KIT_BUCKET=
# Use separate buckets; private kit objects must never be publicly readable.

# Transactional transport, not an external subscriber/content management service.
# Set false for a public, content-only launch before connecting email.
EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
CONTACT_EMAIL=

# See README for the complete backend variables and launch requirements.
